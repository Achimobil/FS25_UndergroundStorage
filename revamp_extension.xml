<!-- Anmeldung bei Production Revamp. Diese Datei liest nur Revamp - ist der Mod nicht installiert, existieren die darin genannten Placeables für das Spiel gar nicht.
     Deshalb stehen sie hier und nicht als storeItem in der modDesc: dort würde ihr Revamp-Placeable-Typ ohne Revamp eine Fehlerzeile im Log erzeugen. -->
<revampExtension>
    <storeItems>
        <storeItem xmlFilename="SmallUndergroundStorageRevamp.xml"/>
        <storeItem xmlFilename="SmallUndergroundStorageCompactRevamp.xml"/>
    </storeItems>
</revampExtension>
